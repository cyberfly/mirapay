APP_NAME=MiraPay
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mirapay.example.com
APP_PORT=80

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Host/port are overridden in docker-compose.prod.yml (mysql:3306)
DB_CONNECTION=mysql
DB_DATABASE=mirapay
DB_USERNAME=mirapay
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_GATEWAY=stripe
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=myr
